# Variables del proceso para captura. Django no carga este archivo automáticamente.
# Ejemplo sin secretos: configurar en el entorno/gestor de secretos autorizado.
EVA_STORAGE_BACKEND=local
# Ruta absoluta privada opcional, fuera del checkout y de estáticos:
# EVA_CAPTURE_PRIVATE_ROOT=C:/ruta-privada/capturas

# Activar s3 solo después de integrar el adaptador y autorizar la cuenta/bucket.
# EVA_STORAGE_BACKEND=s3
EVA_S3_BUCKET=
EVA_S3_REGION=
EVA_S3_PREFIX=eva/capturas/
# Origen HTTPS real alcanzable por PC y teléfono; sin ruta, query o fragmento.
EVA_CAPTURE_BASE_URL=
# boto3 usará su cadena estándar de credenciales o el rol del entorno.
# No incluir claves, tokens ni contraseñas aquí ni en Git.
